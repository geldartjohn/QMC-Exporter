{
  "name": "QMC Exporter",
  "description": "Detects Qlik Sense QMC tables and exports them as CSV, JSON, or XML directly from the extension action.",
  "version": "0.2.0",
  "manifest_version": 3,
  "action": {
    "default_title": "QMC Exporter",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/common/dom-utils.js",
        "src/common/dataset.js",
        "src/common/formatters.js",
        "src/content/main.js",
        "src/content/scanner.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
